# ─── Frontend (Vite — prefixo VITE_ obrigatório) ─────────────────────────────

# Supabase — projeto em https://supabase.com/dashboard
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# n8n — URL base do seu webhook (local ou cloud)
# Local self-hosted:  http://localhost:5678/webhook/lead-finder
# n8n Cloud:          https://<seu-subdominio>.app.n8n.cloud/webhook/lead-finder
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-finder
VITE_N8N_RESULTS_URL=http://localhost:5678/webhook/lead-finder-results

# Google Sheets — URL completa da planilha (exibida no botão "Abrir planilha")
VITE_SHEETS_URL=https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit?gid=0#gid=0


# ─── Supabase Edge Function (secrets — NÃO vão para o frontend) ──────────────
# Configurar via CLI:
#   supabase secrets set GOOGLE_SHEETS_API_KEY=AIza...
#   supabase secrets set SPREADSHEET_ID=1o4D...
#
# GOOGLE_SHEETS_API_KEY=AIza...
# SPREADSHEET_ID=<id-da-planilha-google>
